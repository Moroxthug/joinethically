# ---------------------------------------------------------------------------
# JoinEthically — environment
#
# Copy to .env.local for development. Nothing here is required to run the site:
# every integration degrades to an honest "not configured" message rather than
# a broken flow, so the editorial site builds and deploys before any account
# exists. See docs/launch.md for which of these to set, and when.
# ---------------------------------------------------------------------------

# Canonical origin. Drives metadata, canonical URLs, sitemap, RSS, and OG tags.
# Leave unset on preview deployments — robots.txt then blocks indexing.
NEXT_PUBLIC_SITE_URL=https://joinethically.com

# --- Analytics -------------------------------------------------------------
# Cookieless and aggregate, so there is no consent banner to show. Unset in
# development; the script is not injected without it.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Override only if self-hosting or proxying the script.
NEXT_PUBLIC_PLAUSIBLE_SRC=

# --- Newsletter (pick one provider) ----------------------------------------
BUTTONDOWN_API_KEY=
CONVERTKIT_API_KEY=
CONVERTKIT_FORM_ID=

# --- Membership payments (Stripe) ------------------------------------------
# Without STRIPE_SECRET_KEY the pricing page still renders; the checkout route
# answers 503 with a clear message.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe price IDs, created in the Stripe dashboard to match lib/monetisation/membership.ts.
STRIPE_PRICE_SUPPORTER_MONTHLY=
STRIPE_PRICE_SUPPORTER_ANNUAL=
STRIPE_PRICE_PATRON_MONTHLY=
STRIPE_PRICE_PATRON_ANNUAL=

# --- Ratings data licensing ------------------------------------------------
# Single shared key for the licensed API tier. Replace with per-licensee keys
# in a store before there is more than one customer.
RATINGS_API_KEY=
